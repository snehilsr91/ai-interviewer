# Application
PORT=4000
NODE_ENV=development
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:3000

# Database (PostgreSQL via Prisma)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/ai_interviewer?schema=public"

# Redis (BullMQ and Caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Media Storage (Local Disk or S3-compatible like MinIO/AWS)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=ai-interviewer-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# AI Provider Configuration
# Supported AI_PROVIDER: 'mock', 'openai', 'gemini'
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
GEMINI_API_KEY=

# Security
MASTER_API_KEY=sk_live_master_secret_dev_key_12345
WEBHOOK_SIGNING_SECRET=whsec_dev_webhook_signing_secret_98765
JWT_SECRET=super_secret_interview_jwt_signing_key_for_tokens
